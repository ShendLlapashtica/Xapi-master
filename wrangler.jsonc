{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xapi",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Container local dev needs Docker + (on Windows) WSL2, neither available
  // on this machine -- same reason the relay runs as a local process +
  // tunnel instead (see relay/README.md). Doesn't affect real deploys.
  "dev": { "enable_containers": false },

  // ListenerAgent — Agents SDK Durable Object, polls X on a self-renewing schedule.
  // DomainAuditAgent — same pattern, daily self-renewing schedule, re-audits
  // whatever's marked `watched` in the domains table (see src/audit/domain-audit-agent.ts).
  // E2bRelayContainer — Cloudflare Container fronting relay/ (see relay/README.md):
  // the one hop that can speak gRPC to E2B's envd, since Workers' fetch can't.
  "durable_objects": {
    "bindings": [
      { "name": "LISTENER_AGENT", "class_name": "ListenerAgent" },
      { "name": "DOMAIN_AUDIT_AGENT", "class_name": "DomainAuditAgent" },
      { "name": "E2B_RELAY", "class_name": "E2bRelayContainer" }
    ]
  },
  "containers": [
    {
      "class_name": "E2bRelayContainer",
      "image": "./relay/Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ListenerAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["E2bRelayContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["DomainAuditAgent"] }
  ],

  // VerificationWorkflow — one durable run per newly-discovered repo.
  // DomainAuditWorkflow — one run per domain audit trigger (re-audits create new instances).
  "workflows": [
    {
      "name": "verification-workflow",
      "binding": "VERIFICATION_WORKFLOW",
      "class_name": "VerificationWorkflow"
    },
    {
      "name": "domain-audit-workflow",
      "binding": "DOMAIN_AUDIT_WORKFLOW",
      "class_name": "DomainAuditWorkflow"
    }
  ],

  // Catalog
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xapi-catalog",
      "database_id": "4912fdcc-3ee9-40cd-8390-1daac63c9b6a",
      "migrations_dir": "migrations"
    }
  ],

  // Evidence bundles (build logs, fixture outputs) + capability-tier fixture inputs
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "xapi-evidence" }
  ],

  // Workers AI (embeddings) + Vectorize (similarity search) -- fuzzy
  // pattern-matching alongside the exact-match README fingerprint dedup,
  // see src/verify/embeddings.ts.
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "README_EMBEDDINGS", "index_name": "xapi-readme-embeddings" }
  ],

  "queues": {
    "producers": [
      { "binding": "RAW_POSTS", "queue": "raw-posts" },
      { "binding": "VERIFY_REQUESTS", "queue": "verify-requests" }
    ],
    "consumers": [
      {
        "queue": "raw-posts",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "raw-posts-dlq"
      },
      {
        "queue": "verify-requests",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "verify-requests-dlq"
      }
    ]
  }

  // No explicit `limits.cpu_ms` here -- overriding it requires a paid
  // Workers plan. If you're on Workers Paid, add:
  //   "limits": { "cpu_ms": 300000 }
  // Note this only bounds active CPU time; network I/O, D1/R2 calls, and
  // sleeps don't count against it either way (see BRIEF.md's Workflows
  // billing rationale).
}
