{
  "name": "xapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply xapi-catalog --local",
    "db:migrate:remote": "wrangler d1 migrations apply xapi-catalog --remote",
    "seed:accounts": "tsx scripts/seed-accounts.ts",
    "setup:x-session": "tsx scripts/setup-x-session.ts",
    "build:sandbox-templates": "tsx src/sandbox/templates/build-templates.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "agents": "^0.20.1",
    "rettiwt-api": "^4.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "axios": "^1.19.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.10.0",
    "e2b": "^2.38.0",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
