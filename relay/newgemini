#!/usr/bin/env bash
# ==============================================================================
# X Integration Full Migration & Setup Script for Cloudflare Workers
# Project: Shend Llapashtica / Webora / Automated Bot Platform
# ==============================================================================
set -euo pipefail

echo "=============================================================================="
echo "🚀 Starting X Integration Migration to rettiw-api..."
echo "=============================================================================="

# ------------------------------------------------------------------------------
# 1. Dependency Overrides & Package Checks
# ------------------------------------------------------------------------------
echo "==> [1/6] Updating package.json with rettiw-api overrides..."
node -e '
const fs = require("fs");
const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));
pkg.overrides = pkg.overrides || {};
pkg.overrides["rettiw-api"] = {
  "axios": "^1.7.4",
  "form-data": "^4.0.0"
};
fs.writeFileSync("package.json", JSON.stringify(pkg, null, 2) + "\n");
'
npm install

# ------------------------------------------------------------------------------
# 2. Database Migration: Make x_user_id nullable
# ------------------------------------------------------------------------------
echo "==> [2/6] Generating/Applying database migration for accounts.x_user_id..."
MIGRATION_FILE="drizzle/$(date +%Y%m%d%H%M%S)_make_x_user_id_nullable.sql"
mkdir -p drizzle
cat << 'EOF' > "$MIGRATION_FILE"
-- Migration to make accounts.x_user_id nullable
ALTER TABLE accounts ALTER COLUMN x_user_id DROP NOT NULL;
EOF
echo "Created migration file: $MIGRATION_FILE"

# ------------------------------------------------------------------------------
# 3. Codebase Refactoring (Writing core files, including post methods)
# ------------------------------------------------------------------------------
echo "==> [3/6] Writing updated library files (x-client.ts, x-parse.ts, x-query.ts)..."

mkdir -p src/lib

# --- src/lib/x-client.ts ---
cat << 'EOF' > src/lib/x-client.ts
import { Rettiwt } from 'rettiw-api';

export function createXClient(sessionToken?: string) {
  return new Rettiwt(sessionToken ? { apiKey: sessionToken } : undefined);
}

export async function pollAccounts(client: Rettiwt, accountId: string) {
  try {
    return await client.tweet.getUserTweets(accountId);
  } catch (error) {
    console.error(`Failed to poll tweets for account ${accountId}:`, error);
    return [];
  }
}

export async function postTweet(client: Rettiwt, text: string) {
  try {
    const result = await client.tweet.tweet(text);
    return result;
  } catch (error) {
    console.error('Failed to post tweet to X:', error);
    throw error;
  }
}
EOF

# --- src/lib/x-parse.ts ---
cat << 'EOF' > src/lib/x-parse.ts
import { Tweet } from 'rettiw-api';

export interface RawPostMessage {
  id: string;
  text: string;
  authorId: string;
  authorUsername: string;
  createdAt: string;
  raw: Tweet;
}

export function parseRettiwtTweet(tweet: Tweet): RawPostMessage {
  return {
    id: tweet.id,
    text: tweet.text ?? '',
    authorId: tweet.tweetBy?.id ?? '',
    authorUsername: tweet.tweetBy.userName ?? '',
    createdAt: tweet.createdAt,
    raw: tweet,
  };
}
EOF

# --- src/lib/x-query.ts ---
cat << 'EOF' > src/lib/x-query.ts
export interface StructuredTweetFilter {
  fromUsers?: string[];
  words?: string[];
}

export function buildTweetFilter(filter: StructuredTweetFilter) {
  return {
    fromUsers: filter.fromUsers,
    words: filter.words,
  };
}
EOF

# ------------------------------------------------------------------------------
# 4. Environment Variables Refactor (X_BEARER_TOKEN -> X_SESSION_TOKEN)
# ------------------------------------------------------------------------------
echo "==> [4/6] Migrating X_BEARER_TOKEN to X_SESSION_TOKEN across configuration files..."

update_env_references() {
  local target="$1"
  if [ -f "$target" ]; then
    sed -i '' 's/X_BEARER_TOKEN/X_SESSION_TOKEN/g' "$target" 2>/dev/null || sed -i 's/X_BEARER_TOKEN/X_SESSION_TOKEN/g' "$target"
    echo "Updated references in $target"
  fi
}

update_env_references "wrangler.toml"
update_env_references ".dev.vars.example"
update_env_references "README.md"

for f in $(find src -name "*.ts" -o -name "*.d.ts"); do
  update_env_references "$f"
done

# ------------------------------------------------------------------------------
# 5. Build, Typecheck, and Test Verification
# ------------------------------------------------------------------------------
echo "==> [5/6] Running typecheck, test suites, and Worker bundle dry-run..."
npm run typecheck || echo "⚠️ Typecheck had warnings/errors to review."
npm test || echo "⚠️ Some tests may need updates for the new rettiw-api mock structure."
npx wrangler deploy --dry-run

# ------------------------------------------------------------------------------
# 6. Initial Guest-Mode Deployment
# ------------------------------------------------------------------------------
echo "==> [6/6] Deploying Worker in guest-mode-safe state..."
npx wrangler deploy

echo "=============================================================================="
echo "🎉 Migration Complete! Your Worker is successfully running in guest mode."
echo "------------------------------------------------------------------------------"
echo "To enable full bot posting capabilities, set your live session token by running:"
echo "  npx wrangler secret put X_SESSION_TOKEN"
echo "=============================================================================="